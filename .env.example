# Modelo de produção carregado pelo supervisor; python -m fun não lê .env sozinho.
# No PC, npm run dev lê .env.local e .env; use caminhos locais em vez dos caminhos abaixo.
FUN_PORT=5050
FUN_ORIGINS=https://fun.kw1.com.br
FUN_DATABASE=/root/fun/shared/fun.sqlite3
FUN_CATALOG=/root/fun/shared/catalog.json
FUN_MEDIA=/root/fun/shared/media
FUN_STATIC=/root/fun/current/dist
FUN_LOG=/root/fun/shared/logs/backend.log
FUN_ADMIN_USERNAME=
FUN_ADMIN_PASSWORD=
# Opcional: arquivo privado dos usuários adicionais; vazio usa godmode-users.json junto ao SQLite.
FUN_ADMIN_USERS_FILE=
# Opcional: diretório do dicionário compilado. Vazio/ausente usa content/dictionary do release.
# FUN_DICTIONARY=/root/fun/current/content/dictionary
